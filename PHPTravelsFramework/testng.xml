<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Question 6 – Parallel Execution Framework
  parallel="methods" – runs test methods in parallel
  thread-count="5"   – up to 5 threads simultaneously
  Thread.sleep() is NOT used anywhere in this framework.
  Thread safety is ensured by ThreadLocal<WebDriver> in DriverFactory (Question 7).
-->
<suite name="PHPTravels Automation Suite" parallel="methods" thread-count="5" verbose="1">

    <listeners>
        <listener class-name="listeners.CustomTestListener"/>
    </listeners>

    <!-- Full Regression Suite -->
    <test name="Full Regression">
        <classes>
            <class name="runners.TestRunner"/>
        </classes>
    </test>

    <!-- Smoke Suite -->
    <test name="Smoke Suite">
        <classes>
            <class name="runners.SmokeTestRunner"/>
        </classes>
    </test>

</suite>
